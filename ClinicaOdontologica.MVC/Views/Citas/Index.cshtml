@model IEnumerable<ClinicaOdontologica.Modelos.Cita>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.fechaCita)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.motivo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.estado)
            </th>
            <th>
                Paciente
            </th>
            <th>
                Odontologo
            </th>
            <th>
                Consultorio
            </th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.fechaCita)
                </td>

                <td>
                    @Html.DisplayFor(model => item.motivo)
                </td>

                <td>
                    @Html.DisplayFor(model => item.estado)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Paciente.nombres)
                    @Html.DisplayFor(model => item.Paciente.apellidos)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Odontologo.nombres)
                    @Html.DisplayFor(model => item.Odontologo.apellidos)
                </td>

                <td>
                    @Html.DisplayFor(model => item.Consultorio.numeroSala)
                </td>

                <td>
                    <a asp-action="Edit" asp-route-id="@item.idCita">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.idCita">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.idCita">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>