@model ClinicaOdontologica.Modelos.Cita

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>Cita</h4>
    <hr />

    <dl class="row">

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.fechaCita)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.fechaCita)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.motivo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.motivo)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.estado)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.estado)
        </dd>

        <dt class="col-sm-2">
            Paciente
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Paciente.nombres)
            @Html.DisplayFor(model => model.Paciente.apellidos)
        </dd>

        <dt class="col-sm-2">
            Odontólogo
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Odontologo.nombres)
            @Html.DisplayFor(model => model.Odontologo.apellidos)
        </dd>

        <dt class="col-sm-2">
            Consultorio
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Consultorio.numeroSala)
        </dd>

    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model?.idCita">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>