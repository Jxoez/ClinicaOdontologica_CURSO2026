@model ClinicaOdontologica.Modelos.DetalleCita

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>DetalleCita</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.costoAplicado)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.costoAplicado)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.observaciones)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.observaciones)
        </dd>
    </dl>
        <!--dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.idCita)
        </!dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.idCita)
        </dd>
    </dl>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.idTratamiento)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.idTratamiento)
        </dd-->
    </dl>
        <dt class = "col-sm-2">
            Cita
        </dt>
        <dd class = "col-sm-10">
    @if (Model.Cita != null)
    {
        <p class="mb-1"><strong>Fecha:</strong> @Model.Cita.fechaCita</p>
        <p class="mb-1"><strong>Motivo:</strong> @Model.Cita.motivo</p>
        <p class="mb-1"><strong>Estado:</strong> @Model.Cita.estado</p>
        <p class="mb-1"><strong>Paciente:</strong> @Model.Cita.Paciente?.nombres @Model.Cita.Paciente?.apellidos</p>
        <p class="mb-1"><strong>Odontólogo:</strong> @Model.Cita.Odontologo?.nombres @Model.Cita.Odontologo?.apellidos</p>
        <p class="mb-0"><strong>Consultorio:</strong> Sala @Model.Cita.Consultorio?.numeroSala</p>
    }
    else
    {
        <span>Sin cita asociada</span>
    }
        </dd>
    </dl>
        <dt class = "col-sm-2">
            Tratamiento
        </dt>
        <dd class = "col-sm-10">
    @if (Model.Tratamiento != null)
    {
        <p class="mb-1"><strong>Nombre:</strong> @Model.Tratamiento.nombreTratamiento</p>
        <p class="mb-0"><strong>Descripción:</strong> @Model.Tratamiento.costoBase</p>
    }
    else
    {
        <span>Sin tratamiento asociado</span>
    }
        </dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model?.idDetalleCita">Edit</a> |
    <a asp-action="Index">Back to List</a>
</div>
